rules_version = '2';

// Reglas de seguridad de Bitácora OPTCG.
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // CAMBIÁ ESTE CÓDIGO por el de tu grupo, en minúsculas, sin tildes ni espacios (la app lo manda así
    // aunque lo escriban con mayúsculas). Es lo que les pasás a tus amigos para crear su usuario. Este archivo es público: el código
    // real va solo en la consola de Firebase. Si lo cambiás, los que ya están en el grupo siguen entrando.
    function codigoDelGrupo() { return 'CAMBIAR-ESTE-CODIGO'; }

    function logueado() { return request.auth != null; }
    function miembro() {
      return logueado() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Las cuentas se crean como usuario@bitacora.invalid. Si después agregan su mail, la cuenta pasa a usarlo.
    function cuentaInterna() {
      return logueado() && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z0-9_.-]{3,20}@bitacora[.]invalid$');
    }
    function miUsuario() { return request.auth.token.email.split('@')[0]; }
    function mazoValido() {
      let d = request.resource.data;
      return d.owner == request.auth.uid
        && d.name is string && d.name.size() <= 80
        && d.cards is list && d.cards.size() <= 80;
    }

    // Registro de nombres de usuario: cada nombre es de una sola cuenta para siempre, aunque esa
    // cuenta cambie a su mail. Solo guarda el uid; lo puede consultar cualquiera que haya entrado.
    match /usernames/{name} {
      allow get: if logueado();
      allow list: if false;
      allow create: if cuentaInterna() && name == miUsuario()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Perfil de cada jugador: solo se crea con el código del grupo, con su propio nombre y con el nombre reservado.
    match /users/{uid} {
      allow read: if miembro();
      allow create: if cuentaInterna() && request.auth.uid == uid
        && request.resource.data.codigo == codigoDelGrupo()
        && request.resource.data.username == miUsuario()
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if logueado() && request.auth.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.codigo == resource.data.codigo;
      allow delete: if false;
    }

    // Mazos: los ve todo el grupo; solo su dueño los crea, cambia o borra.
    match /decks/{deckId} {
      allow read: if miembro();
      allow create: if miembro() && mazoValido();
      allow update: if miembro() && resource.data.owner == request.auth.uid && mazoValido();
      allow delete: if miembro() && resource.data.owner == request.auth.uid;
    }

    // Valoraciones: una por jugador y por mazo (id = <mazo>_<uid>), de 1 a 5 estrellas y un comentario corto.
    // No se pueden valorar los mazos propios. Cada uno cambia o borra solo la suya.
    function valoracionValida(rid) {
      let d = request.resource.data;
      let mazo = /databases/$(database)/documents/decks/$(d.deck);
      return d.keys().hasOnly(['deck', 'uid', 'stars', 'text', 'updated'])
        && d.uid == request.auth.uid
        && d.deck is string && rid == d.deck + '_' + request.auth.uid
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.text is string && d.text.size() <= 280
        && d.updated is string
        && exists(mazo) && get(mazo).data.owner != request.auth.uid;
    }
    match /ratings/{rid} {
      allow read: if miembro();
      allow create, update: if miembro() && valoracionValida(rid);
      allow delete: if miembro() && resource.data.uid == request.auth.uid;
    }
  }
}
